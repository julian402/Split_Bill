<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.expense.ExpenseDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cdBack"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/tvTitleExpenseDetail" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Tarjeta destacada: que se gasto, cuanto y quien pago -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorOnHeroSecondary"
                    android:textSize="16sp"
                    tools:text="Almuerzo" />

                <TextView
                    android:id="@+id/tvDetailAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/colorOnHero"
                    android:textSize="34sp"
                    tools:text="$ 60.000,00" />

                <TextView
                    android:id="@+id/tvDetailPayer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/colorOnHero"
                    android:textSize="15sp"
                    tools:text="Pagó Julián Corredor" />

                <TextView
                    android:id="@+id/tvDetailMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/colorOnHeroSecondary"
                    android:textSize="14sp"
                    tools:text="24 sept 2026 · Partes iguales" />

                <TextView
                    android:id="@+id/tvDetailSyncState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tvPendingSync"
                    android:textColor="@color/colorOnHeroSecondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="24dp"
                android:paddingBottom="4dp"
                android:text="@string/tvSectionShares"
                android:textAppearance="@style/TextAppearance.SplitBill.Section" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvShares"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_expense_share" />

            <Button
                android:id="@+id/btnEditExpense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/btnEditExpense"
                app:icon="@drawable/ic_receipt" />

            <Button
                android:id="@+id/btnDeleteExpense"
                style="@style/Widget.SplitBill.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btnDeleteExpense"
                android:textColor="@color/colorDebtor"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/colorDebtor" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
