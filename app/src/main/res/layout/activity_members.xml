<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.group.MembersActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cdBack"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/tvTitleMembers" />

    <!-- Formulario de alta -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvSectionNewMember"
                android:textAppearance="@style/TextAppearance.SplitBill.Section" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/etMemberNames">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMemberNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/etMemberPhone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMemberPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClear"
                    style="@style/Widget.SplitBill.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/btnClear" />

                <Button
                    android:id="@+id/btnSaveMember"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btnSaveMember"
                    app:icon="@drawable/ic_person_add" />
            </LinearLayout>

            <!-- Atajo: elegir varios integrantes de la agenda del celular (pide el permiso de contactos) -->
            <Button
                android:id="@+id/btnAddFromContacts"
                style="@style/Widget.SplitBill.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btnAddFromContacts"
                app:icon="@drawable/ic_contacts" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Solo aparece si el usuario llego aqui queriendo registrar un gasto y ya hay dos integrantes -->
    <Button
        android:id="@+id/btnContinueExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btnContinueExpense"
        android:visibility="gone"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="end" />

    <!-- Solo aparece si hay integrantes agregados por nombre: permite decir "ese soy yo" -->
    <Button
        android:id="@+id/btnClaimMember"
        style="@style/Widget.SplitBill.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/btnClaimMember"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="@string/tvSectionMemberList"
        android:textAppearance="@style/TextAppearance.SplitBill.Section" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="4dp" />

    <TextView
        android:id="@+id/tvEmptyMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:padding="32dp"
        android:text="@string/tvEmptyMembers"
        android:textAlignment="center"
        android:textColor="@color/colorTextSecondary"
        android:visibility="gone"
        app:drawableTint="@color/colorStroke"
        app:drawableTopCompat="@drawable/ic_group" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMembers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_member" />
</LinearLayout>
