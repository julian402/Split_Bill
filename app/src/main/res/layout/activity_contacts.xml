<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.contacts.ContactsActivity">

    <LinearLayout style="@style/Widget.SplitBill.ScreenHeader">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.SplitBill.HeaderButton"
            android:contentDescription="@string/cdBack"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout style="@style/Widget.SplitBill.ScreenHeaderTexts">

            <TextView
                style="@style/Widget.SplitBill.ScreenHeaderTitle"
                android:text="@string/tvTitleContacts" />

            <TextView
                style="@style/Widget.SplitBill.ScreenHeaderSubtitle"
                android:text="@string/tvContactsSubtitle" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/etSearchContact"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="4dp" />

    <TextView
        android:id="@+id/tvEmptyContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:padding="32dp"
        android:text="@string/tvEmptyContacts"
        android:textAlignment="center"
        android:textColor="@color/colorTextSecondary"
        android:visibility="gone"
        app:drawableTint="@color/colorStroke"
        app:drawableTopCompat="@drawable/ic_contacts" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_contact" />

    <Button
        android:id="@+id/btnAddContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/btnAddContactsNone"
        app:icon="@drawable/ic_person_add" />
</LinearLayout>
