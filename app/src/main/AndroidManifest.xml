<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para hablar con el backend y para saber si hay conexion antes de sincronizar -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos peligrosos: se piden en el momento de usarlos con PermissionManager -->
    <!-- Agenda: agregar integrantes desde los contactos -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Camara: escanear el total de una factura. No es obligatoria: sin camara se usa la galeria -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SplitBillApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SplitBill">

        <!-- La app arranca en el login; si ya hay sesion, LoginActivity salta al inicio (HomeActivity) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Las cuatro pestanas de la barra inferior -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.group.GroupsActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <activity
            android:name=".ui.feed.ActivityFeedActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.group.GroupDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupsActivity" />

        <activity
            android:name=".ui.group.GroupFormActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.contacts.ContactsActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupFormActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.scan.ScanReceiptActivity"
            android:exported="false" />

        <activity
            android:name=".ui.expense.AddExpenseActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.expense.ExpenseDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupDetailActivity" />

        <activity
            android:name=".ui.settle.SettlementActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupDetailActivity" />

        <activity
            android:name=".ui.quick.QuickSplitActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.GroupDetailActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
