<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.quick.QuickSplitActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                style="@style/Widget.SplitBill.ScreenHeader"
                android:paddingStart="0dp"
                android:paddingEnd="0dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.SplitBill.HeaderButton"
                    android:contentDescription="@string/cdBack"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout style="@style/Widget.SplitBill.ScreenHeaderTexts">

                    <TextView
                        style="@style/Widget.SplitBill.ScreenHeaderTitle"
                        android:text="@string/tvTitleQuickSplit" />

                    <TextView
                        style="@style/Widget.SplitBill.ScreenHeaderSubtitle"
                        android:text="@string/tvQuickSubtitle" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSavedQuickSplits"
                    style="@style/Widget.SplitBill.HeaderButton"
                    android:contentDescription="@string/cdSavedQuickSplits"
                    android:src="@drawable/ic_history" />
            </LinearLayout>

            <!-- Total de la cuenta, grande. El boton de la derecha abre el escaner de facturas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_highlight"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etQuickTotal"
                        android:textAppearance="@style/TextAppearance.SplitBill.FieldLabel"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prefixCurrencySpaced"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etQuickTotal"
                            style="@style/Widget.SplitBill.PlainInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="none"
                            android:hint="@string/hintAmountZero"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnScanReceipt"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_nav_selected"
                    android:contentDescription="@string/cdScanReceipt"
                    android:foreground="?attr/selectableItemBackground"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorPrimary" />
            </LinearLayout>

            <!-- Propina -->
            <LinearLayout
                style="@style/Widget.SplitBill.FieldCard"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card">

                <ImageView
                    style="@style/Widget.SplitBill.IconCircle"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_percent" />

                <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                    <TextView
                        style="@style/Widget.SplitBill.FieldLabelText"
                        android:text="@string/etTipPercentage" />

                    <TextView
                        android:id="@+id/tvTotalWithTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        tools:text="Total con propina: $ 264.000,00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/etTipPercentage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autofillHints="none"
                        android:background="@null"
                        android:hint="@string/hintAmountZero"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/suffixPercentage"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Entre cuantos / Como se divide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.SplitBill.FieldCard"
                    android:elevation="0dp">

                    <ImageView
                        style="@style/Widget.SplitBill.IconCircle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_group" />

                    <TextView
                        style="@style/Widget.SplitBill.FieldLabelText"
                        android:layout_width="0dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/tvPeopleLabel"
                        android:textAppearance="@style/TextAppearance.SplitBill.FieldValue" />

                    <Button
                        android:id="@+id/btnMinus"
                        style="@style/Widget.SplitBill.Button.IconTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cdRemovePerson"
                        app:icon="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/tvPeopleCount"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="4" />

                    <Button
                        android:id="@+id/btnPlus"
                        style="@style/Widget.SplitBill.Button.IconTonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/cdAddPerson"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/colorStroke" />

                <LinearLayout
                    android:id="@+id/rowSplitType"
                    style="@style/Widget.SplitBill.FieldCard"
                    android:background="?attr/selectableItemBackground"
                    android:elevation="0dp">

                    <ImageView
                        style="@style/Widget.SplitBill.IconCircle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_swap" />

                    <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                        <TextView
                            style="@style/Widget.SplitBill.FieldLabelText"
                            android:text="@string/tvSplitTypeLabel" />

                        <Spinner
                            android:id="@+id/spSplitType"
                            style="@style/Widget.SplitBill.Spinner.Plain" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.SplitBill.FieldChevron"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnCalculate"
                style="@style/Widget.SplitBill.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/btnCalculate"
                app:icon="@drawable/ic_bolt" />

            <!-- Cuanto le toca a cada uno -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/tvQuickResultLabel"
                android:textAppearance="@style/TextAppearance.SplitBill.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQuickShares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_quick_share" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnSaveQuickSplit"
        style="@style/Widget.SplitBill.Button.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btnSaveQuickSplit"
        android:visibility="gone"
        app:icon="@drawable/ic_save"
        tools:visibility="visible" />

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
