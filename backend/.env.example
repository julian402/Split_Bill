# Copiar este archivo como .env y cambiar los valores. El .env real NUNCA se sube a git.
# Lo leen tanto docker compose como Spring Boot (spring.config.import en application.yml).
DB_URL=jdbc:postgresql://localhost:5432/splitbill
DB_USER=splitbill
DB_PASSWORD=splitbill

# Clave para firmar los tokens JWT (HS256): minimo 32 caracteres.
# Para generar una: openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
