<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para hablar con el backend y para saber si hay conexion antes de sincronizar -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SplitBillApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SplitBill">

        <!-- La app arranca en el login; si ya hay sesion, LoginActivity salta a MainActivity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.group.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.group.MembersActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.expense.AddExpenseActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settle.SettlementActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.MainActivity" />

        <activity
            android:name=".ui.quick.QuickSplitActivity"
            android:exported="false"
            android:parentActivityName=".ui.group.MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
