<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.expense.AddExpenseActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                style="@style/Widget.SplitBill.ScreenHeader"
                android:paddingStart="0dp"
                android:paddingEnd="0dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.SplitBill.HeaderButton"
                    android:contentDescription="@string/cdBack"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout style="@style/Widget.SplitBill.ScreenHeaderTexts">

                    <TextView
                        android:id="@+id/tvFormTitle"
                        style="@style/Widget.SplitBill.ScreenHeaderTitle"
                        android:text="@string/tvTitleAddExpense" />

                    <TextView
                        android:id="@+id/tvFormSubtitle"
                        style="@style/Widget.SplitBill.ScreenHeaderSubtitle"
                        tools:text="En Viaje a Cartagena" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pbLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="4dp" />

            <!-- Grupo donde queda el gasto; tocarlo deja escoger otro. No aparece al editar -->
            <LinearLayout
                android:id="@+id/rowGroup"
                style="@style/Widget.SplitBill.FieldCard"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    style="@style/Widget.SplitBill.IconCircle"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_group" />

                <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                    <TextView
                        style="@style/Widget.SplitBill.FieldLabelText"
                        android:text="@string/tvGroupLabel" />

                    <TextView
                        android:id="@+id/tvExpenseGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Viaje a Cartagena" />
                </LinearLayout>

                <ImageView
                    style="@style/Widget.SplitBill.FieldChevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Monto total, grande. El boton de la derecha abre el escaner de facturas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_highlight"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etAmount"
                        android:textAppearance="@style/TextAppearance.SplitBill.FieldLabel"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prefixCurrencySpaced"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etAmount"
                            style="@style/Widget.SplitBill.PlainInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="none"
                            android:hint="@string/hintAmountZero"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnScanReceipt"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_nav_selected"
                    android:contentDescription="@string/cdScanReceipt"
                    android:foreground="?attr/selectableItemBackground"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorPrimary" />
            </LinearLayout>

            <!-- Descripcion -->
            <LinearLayout
                style="@style/Widget.SplitBill.FieldCard"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card">

                <ImageView
                    style="@style/Widget.SplitBill.IconCircle"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_description" />

                <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                    <TextView
                        style="@style/Widget.SplitBill.FieldLabelText"
                        android:text="@string/etDescription" />

                    <EditText
                        android:id="@+id/etDescription"
                        style="@style/Widget.SplitBill.PlainInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:hint="@string/hintDescription"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnClearDescription"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btnClear"
                    android:src="@drawable/ic_close"
                    app:tint="@color/colorTextSecondary" />
            </LinearLayout>

            <!-- Quien pago / Como se divide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowPayer"
                    style="@style/Widget.SplitBill.FieldCard"
                    android:background="?attr/selectableItemBackground"
                    android:elevation="0dp">

                    <ImageView
                        style="@style/Widget.SplitBill.IconCircle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person" />

                    <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                        <TextView
                            style="@style/Widget.SplitBill.FieldLabelText"
                            android:text="@string/tvPayerLabel" />

                        <Spinner
                            android:id="@+id/spPayer"
                            style="@style/Widget.SplitBill.Spinner.Plain" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.SplitBill.FieldChevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/colorStroke" />

                <LinearLayout
                    android:id="@+id/rowSplitType"
                    style="@style/Widget.SplitBill.FieldCard"
                    android:background="?attr/selectableItemBackground"
                    android:elevation="0dp">

                    <ImageView
                        style="@style/Widget.SplitBill.IconCircle"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_group" />

                    <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                        <TextView
                            style="@style/Widget.SplitBill.FieldLabelText"
                            android:text="@string/tvSplitTypeLabel" />

                        <Spinner
                            android:id="@+id/spSplitType"
                            style="@style/Widget.SplitBill.Spinner.Plain" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.SplitBill.FieldChevron"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Participantes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tvParticipantsLabel"
                        android:textAppearance="@style/TextAppearance.SplitBill.SectionTitle"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:text="@string/tvSelectAll"
                        android:textAppearance="@style/TextAppearance.SplitBill.Link" />
                </LinearLayout>

                <!-- Solo si viene de una cuenta rapida: cuantas personas hay que marcar -->
                <TextView
                    android:id="@+id/tvFromQuickSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_card_soft"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_bolt"
                    app:drawableTint="@color/colorPrimary"
                    tools:text="Viene de una cuenta rápida entre 4 personas: marca a esas personas."
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvParticipants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_participant"
                    tools:spanCount="3" />
            </LinearLayout>

            <!-- Fecha y categoria -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/rowDate"
                    style="@style/Widget.SplitBill.FieldCard"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        style="@style/Widget.SplitBill.IconCircle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar" />

                    <LinearLayout
                        style="@style/Widget.SplitBill.FieldTexts"
                        android:layout_marginStart="10dp">

                        <TextView
                            style="@style/Widget.SplitBill.FieldLabelText"
                            android:text="@string/tvDateLabel" />

                        <TextView
                            android:id="@+id/tvExpenseDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="2"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            tools:text="Hoy, 24 de sep. de 2026" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowCategory"
                    style="@style/Widget.SplitBill.FieldCard"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/ivCategory"
                        style="@style/Widget.SplitBill.IconCircle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tag" />

                    <LinearLayout
                        style="@style/Widget.SplitBill.FieldTexts"
                        android:layout_marginStart="10dp">

                        <TextView
                            style="@style/Widget.SplitBill.FieldLabelText"
                            android:text="@string/tvCategoryLabel" />

                        <Spinner
                            android:id="@+id/spCategory"
                            style="@style/Widget.SplitBill.Spinner.Plain" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Division estimada, se recalcula mientras se escribe -->
            <LinearLayout
                style="@style/Widget.SplitBill.FieldCard"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_soft"
                android:elevation="0dp">

                <ImageView
                    style="@style/Widget.SplitBill.IconCircle"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bar_chart" />

                <LinearLayout style="@style/Widget.SplitBill.FieldTexts">

                    <TextView
                        style="@style/Widget.SplitBill.FieldLabelText"
                        android:text="@string/tvEstimatedSplit"
                        android:textColor="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/tvEstimate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Cada uno paga $ 176.666,67" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvParticipantCount"
                    style="@style/Widget.SplitBill.Chip.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/colorHighlightStroke"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    tools:text="3 participantes" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnSaveExpense"
        style="@style/Widget.SplitBill.Button.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btnSaveExpense"
        app:icon="@drawable/ic_save" />

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
