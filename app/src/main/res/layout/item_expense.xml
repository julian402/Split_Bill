<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de un gasto o pago: icono de la categoria, descripcion, quien pago, fecha, monto y como se dividio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemExpense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Encabezado del dia ("Hoy", "Ayer"): solo en la pantalla de actividad -->
    <TextView
        android:id="@+id/tvDayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp"
        android:textAppearance="@style/TextAppearance.SplitBill.Section"
        android:visibility="gone"
        tools:text="Hoy"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/rowExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/ivCategory"
            style="@style/Widget.SplitBill.IconCircle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="14dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_cart" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemTitle"
                tools:text="Supermercado" />

            <TextView
                android:id="@+id/tvPayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemSubtitle"
                tools:text="Pagó Andres · Viaje a Cartagena" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                tools:text="Hoy, 14:30" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SplitBill.Amount"
                tools:text="$ 36.688,00" />

            <TextView
                android:id="@+id/tvSplitType"
                style="@style/Widget.SplitBill.Chip.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                tools:text="Partes iguales" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="82dp"
        android:layout_marginEnd="16dp"
        android:background="@color/colorStroke" />
</LinearLayout>
