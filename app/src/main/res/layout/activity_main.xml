<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.group.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado: nombre de la app y acceso a los integrantes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tvAppGreeting"
                    android:textAppearance="@style/TextAppearance.SplitBill.ItemSubtitle"
                    android:textColor="@color/colorPrimary"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tvTitleMain"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Estado de la sincronizacion con el servidor -->
                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SplitBill.ItemSubtitle"
                    tools:text="@string/tvSynced" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSync"
                style="@style/Widget.SplitBill.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cdSync"
                app:icon="@drawable/ic_sync" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.SplitBill.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cdLogout"
                app:icon="@drawable/ic_logout" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMembers"
            style="@style/Widget.SplitBill.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btnMembers"
            app:icon="@drawable/ic_group" />

        <!-- Tarjeta destacada con el total del grupo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_hero"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvTotalLabel"
                android:textColor="@color/colorOnHeroSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/colorOnHero"
                android:textSize="36sp"
                app:autoSizeMaxTextSize="36sp"
                app:autoSizeMinTextSize="22sp"
                app:autoSizeTextType="uniform"
                tools:text="$ 180.000,00" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSettle"
                    style="@style/Widget.SplitBill.Button.OnHero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/btnSettle"
                    app:icon="@drawable/ic_swap" />

                <Button
                    android:id="@+id/btnQuickSplit"
                    style="@style/Widget.SplitBill.Button.OnHero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btnQuickSplit"
                    app:icon="@drawable/ic_bolt" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="@string/tvSectionExpenses"
            android:textAppearance="@style/TextAppearance.SplitBill.Section" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pbLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tvEmptyExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="12dp"
            android:padding="32dp"
            android:text="@string/tvEmptyExpenses"
            android:textAlignment="center"
            android:textColor="@color/colorTextSecondary"
            android:visibility="gone"
            app:drawableTint="@color/colorStroke"
            app:drawableTopCompat="@drawable/ic_receipt" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_expense" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/btnAddExpense"
        android:textColor="@color/colorOnPrimary"
        app:backgroundTint="@color/colorPrimary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/colorOnPrimary" />
</FrameLayout>
