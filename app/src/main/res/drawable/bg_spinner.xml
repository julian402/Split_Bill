<?xml version="1.0" encoding="utf-8"?>
<!-- Borde de las listas de selección, con la flecha a la derecha -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/colorCard" />
            <stroke android:width="1dp" android:color="@color/colorTextSecondary" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:end="16dp"
        android:drawable="@drawable/ic_expand_more"
        android:gravity="end|center_vertical" />
</layer-list>
