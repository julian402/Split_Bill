<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <EditText
        android:id="@+id/etPersonName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autofillHints="name"
        android:background="@null"
        android:inputType="textPersonName|textCapWords"
        android:minHeight="48dp"
        android:textAppearance="@style/TextAppearance.SplitBill.ItemTitle"
        tools:text="Persona 1" />

    <EditText
        android:id="@+id/etPersonValue"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:autofillHints="none"
        android:background="@drawable/bg_input"
        android:hint="@string/hintValueExact"
        android:inputType="numberDecimal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvPersonAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="110dp"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.SplitBill.Amount"
        android:textColor="@color/colorPrimary"
        tools:text="$ 66.000,00" />
</LinearLayout>
