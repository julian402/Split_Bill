<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo en Android 11 o anterior: no se copia nada, por la misma razon que en
    data_extraction_rules.xml (los datos se recuperan del servidor y el token solo sirve en este
    celular).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
