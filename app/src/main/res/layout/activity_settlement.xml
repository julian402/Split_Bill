<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.settle.SettlementActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <LinearLayout style="@style/Widget.SplitBill.ScreenHeader">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.SplitBill.HeaderButton"
                    android:contentDescription="@string/cdBack"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout style="@style/Widget.SplitBill.ScreenHeaderTexts">

                    <TextView
                        style="@style/Widget.SplitBill.ScreenHeaderTitle"
                        android:text="@string/tvTitleSettlement" />

                    <TextView
                        style="@style/Widget.SplitBill.ScreenHeaderSubtitle"
                        android:text="@string/tvSettlementSubtitle" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pbLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="4dp" />

            <!-- Plan de pagos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_hero"
                android:elevation="6dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="100dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tvSettlementHeroLabel"
                        android:textColor="@color/colorOnHeroSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvTransferSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/colorOnHero"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="1 transferencia en lugar de 2" />

                    <TextView
                        android:id="@+id/tvAllSettled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/tvAllSettled"
                        android:textColor="@color/colorOnHero"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSettlementHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/tvSettlementHint"
                        android:textColor="@color/colorOnHeroSecondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <include
                    layout="@layout/view_hero_deco"
                    android:layout_width="96dp"
                    android:layout_height="88dp"
                    android:layout_gravity="end|center_vertical" />
            </FrameLayout>

            <!-- Transferencias sugeridas -->
            <LinearLayout
                android:id="@+id/sectionTransfers"
                style="@style/Widget.SplitBill.SectionHeader">

                <TextView
                    style="@style/Widget.SplitBill.SectionHeaderTitle"
                    android:text="@string/tvTransfersLabel" />

                <TextView
                    android:id="@+id/tvTransferCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:textAppearance="@style/TextAppearance.SplitBill.Link"
                    tools:text="1 transferencia" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransfers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="1"
                tools:listitem="@layout/item_transfer" />

            <!-- Saldo de cada integrante -->
            <LinearLayout style="@style/Widget.SplitBill.SectionHeader">

                <TextView
                    style="@style/Widget.SplitBill.SectionHeaderTitle"
                    android:text="@string/tvBalancesLabel" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBalances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_balance" />

            <!-- Resumen -->
            <LinearLayout style="@style/Widget.SplitBill.SectionHeader">

                <TextView
                    style="@style/Widget.SplitBill.SectionHeaderTitle"
                    android:text="@string/tvSettlementSummary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/bg_divider_vertical"
                    android:dividerPadding="10dp"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:showDividers="middle">

                    <LinearLayout style="@style/Widget.SplitBill.SummaryStat">

                        <ImageView
                            style="@style/Widget.SplitBill.SummaryStatIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_group" />

                        <TextView
                            style="@style/Widget.SplitBill.SummaryStatLabel"
                            android:text="@string/tvTotalLabel" />

                        <TextView
                            android:id="@+id/tvSummaryTotal"
                            style="@style/Widget.SplitBill.SummaryStatValue"
                            tools:text="$ 566.688,00" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SplitBill.SummaryStat">

                        <ImageView
                            style="@style/Widget.SplitBill.SummaryStatIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bar_chart" />

                        <TextView
                            style="@style/Widget.SplitBill.SummaryStatLabel"
                            android:text="@string/tvSettledPeople" />

                        <TextView
                            android:id="@+id/tvSummarySettled"
                            style="@style/Widget.SplitBill.SummaryStatValue"
                            tools:text="1 de 3" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SplitBill.SummaryStat">

                        <ImageView
                            style="@style/Widget.SplitBill.SummaryStatIcon"
                            android:backgroundTint="@color/colorCreditorContainer"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check"
                            app:tint="@color/colorCreditor" />

                        <TextView
                            style="@style/Widget.SplitBill.SummaryStatLabel"
                            android:text="@string/tvTransfersShort" />

                        <TextView
                            android:id="@+id/tvSummaryTransfers"
                            style="@style/Widget.SplitBill.SummaryStatValue"
                            tools:text="1 en total" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnMarkAllPaid"
        style="@style/Widget.SplitBill.Button.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btnMarkAllPaid"
        app:icon="@drawable/ic_check_circle" />

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
